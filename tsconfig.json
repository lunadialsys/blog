{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "paths": {
            "@components/*": ["./src/components/*"],
            "@util/*": ["./src/util/*"],
            "@layouts/*": ["./src/layouts/*"],
        },
    },
}
