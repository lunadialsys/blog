---

---
<div class="md">
    <slot/>
</div>

<style is:global>
.md>:first-child {
    margin-top: 0;
}
.md>:last-child {
    margin-bottom: 0;
}

.md>* {
    line-height: 150%;
}

.md h1 {
    margin: 0.5rem 0;
    font-size: 32pt;
    font-weight: 400;
}
.md h2 {
    margin: 2rem 0 0.5rem 0;
    font-size: 18pt;
    font-weight: 400;
}
.md h3 {
    margin: 1.5rem 0 0.5rem 0;
    font-size: 16pt;
    font-weight: 400;
}

.md p {
    margin: 0.5rem 0;
    line-height: 150%;
}
.md ul {
    margin: 0 0;
    line-height: 150%;
}

.md sup {
    margin: 0 2pt;
}
.md sup>* {
    color: var(--deemphasise);
}

/* inline code blocks */
.md code {
    font-family: var(--font-code);
    background-color: transparent;
    padding: 0pt 4pt;
    background-color: var(--codeblock-bg-inline);
    border-radius: 6pt;
    font-size: 10pt;
}

/* make it work in headings */
.md h1 code {
    font-size: 18pt;
}
.md h2 code {
    font-size: 16pt;
}
.md h3 code {
    font-size: 14pt;
}

/* full code blocks */
.md code>* {
    font-size: 11pt;
    font-family: var(--font-code);
}

.md pre {
    padding: 6pt 10pt 6pt 10pt;
    border-radius: 5px;
    margin-top: 0;
}

.astro-code {
    background-color: var(--codeblock-bg) !important;

    span {
        background-color: transparent !important;
    }
}

.codeblock {
    position: relative;
    margin-top: 1rem;
}

.codeblock code {
    padding: 0;
    background-color: transparent;
}

.codeblock>.codeblock-tag {
    position: absolute;
    right: 0;
    bottom: 0;
    margin-right: 10pt;
    margin-bottom: 6pt;
    display: inline-block;
    color: var(--deemphasise);
    font-family: var(--font-code);
    font-size: 9pt;
    user-select: none;
    pointer-events: none;
}
</style>

<style is:global>
body[data-theme="light"] {
    .astro-code,
    .astro-code span {
        color: var(--shiki-light) !important;
    }
}
</style>
