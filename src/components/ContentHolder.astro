---

const noBg = Astro.props.noBackground;
const page = Astro.props.page;

---
<div class:list={['content', {['no-bg']: noBg, ['page']: page} ]}>
    <slot/>
</div>

<style>
.content {
    background-color: #00000077;
    padding: 2rem;
    margin-top: 3rem;
    margin-bottom: 8rem;
}

.content.no-bg {
    background: none;
    padding: 0;
}

@media screen and (min-width: 60rem) {
    .content {
        max-width: 60rem;
        margin-left: auto;
        margin-right: auto;
        position: relative;
    }
}
</style>
