---

const noBg = Astro.props.noBackground;
const page = Astro.props.page;

---
<div class:list={['content', {['no-bg']: noBg, ['page']: page} ]}>
    <slot/>
</div>

<style>
.content {
    padding: 2rem;
    margin-bottom: 4rem;
}

.content.no-bg {
    background: none;
    padding: 0;
}

@media screen and (min-width: 600px) {
    .content {
        background-color: #00000077;
        max-width: 60rem;
        margin-left: auto;
        margin-right: auto;
        margin-top: 3rem;
    }
}
</style>
