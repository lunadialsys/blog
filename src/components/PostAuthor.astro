---
const d = Astro.props.name;

const NAMES: { [n: string]: string } = {
    'nightshade': 'Nightshade',
    'crescent': 'Crescent'
}
---
<div class:list={['author']} data-author={d}>
    <span>{NAMES[d]}</span>
</div>

<style>

.author {
    display: inline-block;
    background-color: var(--accent);
    color: black;
    padding: 1pt 3pt;
    border-radius: 4px;
}

</style>
