---
const d = Astro.props.name;

const NAMES: { [n: string]: string } = {
    'nightshade': 'Nightshade',
    'crescent': 'Crescent'
}
---
<div class:list={['author']} data-author={d}>
    <span>{NAMES[d]}</span>
</div>

<style>
.author {
    display: inline-block;
    padding: 1pt 3pt;
    background-color: var(--c);
    color: var(--tc);
    border-radius: 4px;
}
</style>

<style>

.author[data-author="nightshade"] {
    --c: var(--accent-nightshade);
    --tc: var(--text-nightshade);
}

.author[data-author="crescent"] {
    --c: var(--accent-crescent);
    --tc: var(--text-crescent);
}

</style>
