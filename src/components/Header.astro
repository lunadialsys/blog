---

---
<div class="header-container">
    <div>
        <a class="header-big" href="/">Luna Dial System</a>
        <a class="header-line" href="/">Neurodiversity, multiplicity, gender transition, and .NET</a>
    </div>
    <div style="flex-grow: 1;"></div>
    <div class="header-inner">
        <a href="/about">About us</a>
        <div class="lang-select">
            <a data-selected>English</a>
            <span class="sep"></span>
            <a>Italiano</a>
        </div>
    </div>
</div>

<style>
.header-container {
    color: var(--text);
    position: relative;
    padding: 2rem 4em 3.5rem 4em;
    display: flex;
    flex-direction: row;
    align-content: end;
    align-items: end;
    font-weight: 300;
    overflow-x: hidden;

    --header-font-size: 36pt;
    --inner-font-size: 15pt;
}

.header-container a {
    text-decoration: none;
}

.header-container::before {
    content: '';
    background-color: #00000077;
    position: absolute;
    overflow: hidden;
    width: calc(100% + 20px);
    height: 100%;
    margin-left: -10px;
    margin-top: -10px;
    left: 0;
    top: 0;
    filter: blur(8px);
    z-index: -2;
}

.header-inner {
    display: flex;
    flex-direction: row;
    column-gap: 3rem;
    font-size: var(--inner-font-size);
}
.header-inner * {
    color: var(--text-neutral);
    margin: 0;
}

.lang-select>.sep {
    display: inline-block;
    --pad: 0.5rem;
    margin-left: var(--pad);
    margin-right: var(--pad);
}
.lang-select>* {
    position: relative;
}
.lang-select>[data-selected] {
    pointer: cursor;
    pointer-events: none;
    color: black;
}
.lang-select>[data-selected]::after {
    content: '';
    position: absolute;
    --pad-h: 4pt;
    --pad-v: 2pt;
    left: calc(var(--pad-h) * -1);
    top: calc(var(--pad-v) * -1);
    width: calc(100% + var(--pad-h) * 2);
    height: calc(100% + var(--pad-v) * 2);
    border-radius: 8px;
    background-color: var(--accent);
    z-index: -1;
    animation: 200ms forwards fade-in;
}

.header-inner a {
    position: relative;
    cursor: pointer;
}
.header-inner a:hover {
    transition: color 100ms;
    color: black;
}
.header-inner a:hover::before {
    content: '';
    position: absolute;
    --pad-h: 4pt;
    --pad-v: 2pt;
    left: calc(var(--pad-h) * -1);
    top: calc(var(--pad-v) * -1);
    width: calc(100% + var(--pad-h) * 2);
    height: calc(100% + var(--pad-v) * 2);
    border-radius: 8px;
    background-color: var(--accent);
    z-index: -1;
    animation: 200ms forwards fade-in;
}
@keyframes fade-in {
    0% {opacity: 0%;}
    100% {opacity: 100%;}
}

.header-big {
    font-size: var(--header-font-size);
    margin: 0;
    font-weight: 300;
    transform: translate(-4px);
    display: block;
}

.header-line {
    font-size: var(--inner-font-size);
    margin: 0;
    margin-top: 0;
    display: block;
}
</style>
