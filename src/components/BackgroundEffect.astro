---

---
<div class="background-effect" style="--x: 50%;" transition:persist></div>
<div class="background-effect-overlay" transition:persist></div>

<style>
.background-effect {
    position: fixed;
    left: 0;
    top: 0;
    width: 100dvw;
    height: 100dvh;
    margin: 0;
    padding: 0;
    z-index: -100;
    --x: 50vw;
    background: radial-gradient(circle at left var(--x) top 120%, white 0%, #777 110%);
}

/* disable all of this on firefox */
body[data-has-feature*="disable-webkit-transitions"]:not([data-subtheme]) {
    --to: #555;
}

body[data-has-feature*="disable-webkit-transitions"] .background-effect {
    background: radial-gradient(circle at left var(--x) top 120%, var(--to) 0%, #111 110%);
}

body[data-has-feature*="disable-webkit-transitions"] .background-effect-overlay {
    display: none;
}

@property --from {
    syntax: '<color>';
    initial-value: #555;
    inherits: true;
}

@property --to {
    syntax: '<color>';
    initial-value: #555;
    inherits: true;
}

.background-effect-overlay {
    position: fixed;
    left: 0;
    top: 0;
    width: 100dvw;
    height: 100dvh;
    --from: inherit;
    --to: inherit;
    margin: 0;
    padding: 0;
    z-index: -99;
    mix-blend-mode: multiply;
}

/* only play the transition animation if we're actually transitioning from somewhere */
body[data-subtheme-from] .background-effect-overlay {
    animation: 500ms forwards background-overlay-fade;
}

/* if not, just directly set the colour to what it should be in the end */
body:not([data-subtheme-from]) .background-effect-overlay {
    background-color: var(--to);
}

@keyframes background-overlay-fade {
    from {
        background-color: var(--from);
    }
    to {
        background-color: var(--to);
    }
}

body[data-subtheme-from="nightshade"] {
    --from: var(--c-nightshade);
}

body[data-subtheme="nightshade"] {
    --to: var(--c-nightshade);
}

body[data-subtheme-from="crescent"] {
    --from: var(--c-crescent);
}

body[data-subtheme="crescent"] {
    --to: var(--c-crescent);
}
</style>

<script>
import { flagFeature, SiteFeature } from "@util/features";

const $ = (x: any) => document.querySelector(x)!;
const el = $('.background-effect');

document.addEventListener('mousemove', (ev) => {
    el.setAttribute('style', `--x: ${ev.pageX}px`);
});

// Firefox breaks things, because of course it does
function renderingEngineHasSkillIssue(): boolean {
    return navigator.userAgent.match(/Gecko\/\d+/) != null;
}

if (!renderingEngineHasSkillIssue()) {
    document.addEventListener('astro:before-swap', (ev) => {
        const fromSubtheme = $('body').getAttribute('data-subtheme');
        const newEl = ev.newDocument.querySelector('body')!;
        if (fromSubtheme == null) {
            newEl.setAttribute('data-subtheme-from', '');
        } else {
            newEl.setAttribute('data-subtheme-from', fromSubtheme);
        }
    });
} else {
    console.log('Detected rendering engine skill issue (user is on Gecko), disabling animated background transitions. Sad :(');
    flagFeature(SiteFeature.NoWebkitTransitions);
    document.addEventListener('astro:after-swap', () => {
        flagFeature(SiteFeature.NoWebkitTransitions);
    });
}

</script>
