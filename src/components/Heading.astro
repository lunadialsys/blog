---
import type { JSX } from "astro/jsx-runtime";
const Heading = `h${Astro.props.level}` as keyof JSX.IntrinsicElements;

---
{/*@ts-expect-error this isn't true*/}
<Heading class="ld-heading" id={Astro.props.id}>
    <slot/>
    <a href={`#${Astro.props.id}`} class="permalink icon" title="Permalink">link_2</a>
    <hr class="heading-sep" aria-role="presentation" />
</Heading>

<style is:global>
.ld-heading {
    width: fit-content;
}

.ld-heading .permalink {
    display: inline-block;
    align-self: center;
    margin-left: 4pt;
    font-size: 15pt;
    overflow: clip;
    text-decoration: none;
    color: color(from var(--text) srgb r g b / 0.4);
    transition: 200ms color;
    /* this is an insanely ugly hack! */
    --clip: 3.5pt;
    --shift: 2pt;
    transform: translateY(var(--shift));
    clip-path: polygon(0 var(--clip), 100% var(--clip), 100% calc(100% - var(--clip)), 0 calc(100% - var(--clip)));
}

.ld-heading .permalink:hover {
    color: color(from var(--text) srgb r g b / 0.6);
    transition: 200ms color;
}

.ld-heading hr {
    --fade: 4rem;
    --fade-start: 2rem;
    margin-right: calc(var(--fade-start) * -1);
    border: 0;
    height: 2px;
    margin-top: 2pt;
    margin-bottom: 1rem;
    background: linear-gradient(to right, var(--accent) 0%,
        var(--accent) calc(100% - var(--fade) * 2),
        color(from var(--accent) srgb r g b / 0.0) 100%);
}
</style>
