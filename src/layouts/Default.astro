---
import {Font} from 'astro:assets';

import BackgroundEffect from '../components/BackgroundEffect.astro';
import Header from '../components/Header.astro';

const title = Astro.props.title;
const titleHeader = "Luna Dial System";
import {ClientRouter} from 'astro:transitions';
---
<html transition:name="root" transition:animate="none">
    <head>
        <Font cssVariable="--font-main" preload />
        <Font cssVariable="--font-code" />
        <slot name="fonts" />

        <title>{title?.length > 0 ? `${title} / ${titleHeader}` : titleHeader}</title>

        <slot name="meta" />
        <meta name="og:site_name" content={titleHeader} />
        <meta name="theme-color" content="#332044" />
        <link rel="icon" href="/favicon.svg" />
        <meta charset="utf-8"/>
        <ClientRouter fallback="none" />
    </head>
    <body data-theme="dark" data-subtheme={Astro.props.author}>
        <BackgroundEffect transition:persist="bg" />
        <Header />
        <slot/>
    </body>
</html>

<style is:global>
body {
    --text-dark: #ddd;
    --deemphasise-dark: #888;
    
    --accent-dark: #dcc5f4;
    
    --bg-outer-dark: #0c0c0c;
    --bg-hotspot-dark: #222222;

    --codeblock-bg-dark: #22222255;
    --codeblock-bg-inline-dark: #222222aa;

    --accent-nightshade: #efbaff;
    --text-nightshade: black;

    --accent-crescent: #64c4ff;
    --text-crescent: black;
    
    --c-nightshade: oklch(0.3121 0.069 307);
    --c-crescent: oklch(0.3528 0.049 238.12);
}

body[data-theme="dark"] {
    --text: var(--text-dark);
    --deemphasise: var(--deemphasise-dark);
    --accent: var(--accent-dark);
    --bg-outer: var(--bg-outer-dark);
    --bg-hotspot: var(--bg-hotspot-dark);
    --codeblock-bg: var(--codeblock-bg-dark);
    --codeblock-bg-inline: var(--codeblock-bg-inline-dark);
}

.icon {
    font-family: var(--font-icons);
}

.deemphasise {
    color: var(--deemphasise);
}

body {
    color: var(--text);
    font-family: var(--font-main);
    margin: 0;
    scrollbar-width: thin;
    scrollbar-gutter: stable;
    overflow-y: scroll;
}

a {
    color: var(--text);
}

*::selection, *::-moz-selection {
    color: black;
    background: var(--accent);
}

.accent {
    color: var(--accent);
}

</style>
