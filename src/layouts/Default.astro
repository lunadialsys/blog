---
import {Font} from 'astro:assets';

import BackgroundEffect from '../components/BackgroundEffect.astro';
import Header from '../components/Header.astro';

const title = Astro.props.title;
const titleHeader = "Luna Dial System";
---
<html>
    <head>
        <Font cssVariable="--font-main" preload />
        <Font cssVariable="--font-code" />
        <slot name="fonts" />
        <meta charset="utf-8"/>
        <title>{title?.length > 0 ? `${title} / ${titleHeader}` : titleHeader}</title>
    </head>
    <body data-theme="dark">
        <BackgroundEffect />
        <Header />
        <slot/>
    </body>
</html>

<style is:global>
body {
    --text-dark: #ddd;
    --deemphasise-dark: #888;
    
    --accent-dark: #dcc5f4;
    
    --bg-outer-dark: oklch(0.156 0.035 307);
    --bg-hotspot-dark: oklch(0.285 0.069 307);

    --codeblock-bg-dark: #22222255;
    --codeblock-bg-inline-dark: #222222aa;
}

body[data-theme="dark"] {
    --text: var(--text-dark);
    --deemphasise: var(--deemphasise-dark);
    --accent: var(--accent-dark);
    --bg-outer: var(--bg-outer-dark);
    --bg-hotspot: var(--bg-hotspot-dark);
    --codeblock-bg: var(--codeblock-bg-dark);
    --codeblock-bg-inline: var(--codeblock-bg-inline-dark);
}

.icon {
    font-family: var(--font-icons);
}

.deemphasise {
    color: var(--deemphasise);
}

body {
    color: var(--text);
    font-family: var(--font-main);
    margin: 0;
    scrollbar-width: thin;
    scrollbar-gutter: stable;
    overflow-y: scroll;
}

a {
    color: var(--text);
}

*::selection, *::-moz-selection {
    color: black;
    background: var(--accent);
}

.accent {
    color: var(--accent);
}

</style>
