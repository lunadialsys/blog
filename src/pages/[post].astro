---
import type { GetStaticPaths } from "astro";
import Page from '../layouts/Page.astro'
import { getCollection } from "astro:content";
import MarkdownContent from "../components/MarkdownContent.astro";
import { render } from "astro:content";
import { getEntry } from "astro:content";
import PostHeader from "../components/PostHeader.astro";
import Note from "../components/Note.astro";
import Heading from "../components/Heading.astro";

export const getStaticPaths = (async () => {
	const allPosts = await getCollection('blog');
	return allPosts.map((e: any) => ({ params: {post: e.id} }));
}) satisfies GetStaticPaths;

const {post} = Astro.params;
const entry = await getEntry('blog', post);
const {Content} = await render(entry!);

---
<Page author={entry?.data.authors[0]} {...entry?.data}>
    <meta name="og:title" content={`${entry?.data.title}`} slot="meta"/>
    {
        entry?.data.foreword ? 
            <meta name="og:description" content={`${entry?.data.foreword}`} slot="meta"/>
            : <></>
    }
    
    <PostHeader title={entry?.data.title} post={entry} />
    <div class="separator"/>
    <MarkdownContent>
        <Content components={{
            ldnote: Note,
            ldheading: Heading
        }} />
    </MarkdownContent>
</Page>

<style>
.separator {
    margin-bottom: 1.5rem;
}
</style>
